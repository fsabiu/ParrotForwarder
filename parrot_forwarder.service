[Unit]
Description=ParrotForwarder v2 supervisor
Documentation=https://github.com/fsabiu/ParrotForwarder
After=network.target
Requires=network.target

[Service]
Type=simple
# Adjust these three lines for the target machine before enabling the unit.
User=parrot
Group=parrot
WorkingDirectory=/opt/parrot-forwarder
ExecStart=/opt/parrot-forwarder/.venv/bin/parrot-forwarder-supervisor --config /etc/parrot-forwarder/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parrot_forwarder

# Environment variables
Environment=PYTHONPATH=/opt/parrot-forwarder
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/parrot-forwarder/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Security settings (relaxed for conda environment access)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=false
ProtectHome=false

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
